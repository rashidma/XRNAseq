// Centralized resource tuning, keyed by process label.
// Modules carry `label 'process_x'` instead of hardcoded cpus/memory so each
// environment (local / KAIMRC slurm / google_batch) can retune independently
// without touching any .nf module file.

process {
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '8 GB'
        time   = '4h'
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = '16 GB'
        time   = '8h'
    }
    withLabel: 'process_high_memory' {
        cpus   = 8
        memory = '48 GB'
        time   = '12h'
    }
}
