// Minimal end-to-end smoke test using a chr21-only subset of the genome.
// See README.md "Generating test assets" for the exact commands to build
// the files referenced below -- they are NOT included in this repo (real
// reference/sequencing data, generated on your own machine).
//
// run_fusion is intentionally left at the global default (off) here: a
// single-chromosome subset cannot meaningfully exercise fusion detection
// (fusions are frequently inter-chromosomal), so a green run of this test
// profile does not validate Arriba's actual sensitivity -- only pipeline
// mechanics for the other branches.

params {
    samplesheet    = "${projectDir}/assets/test_samplesheet.csv"
    genome_fasta   = "${projectDir}/assets/test_genome.fa"
    gtf            = "${projectDir}/assets/test_annotation.gtf"
    known_sites    = "${projectDir}/assets/test_known_sites.vcf.gz"
    outdir         = 'test_results'

    read_length    = 100 // matches assets/generate_test_fastqs.py's READ_LEN
    contrast       = 'condition:treated_vs_control'
    design_formula = '~ condition'

    // STAR's own recommendation for a genome this small (chr21 alone, ~46.7Mb)
    // is well below the whole-genome default of 14 -- keeps the suffix array
    // index proportional to the actual reference size instead of wasting
    // memory sized for a 3Gb genome.
    star_genome_sa_index_n_bases = 11

    run_dge             = true
    run_gsea             = false // requires a user-supplied MSigDB .gmt; off by default in the test profile
    run_variant_calling = true
    run_annotation       = false // requires a snpEff database download; off by default in the test profile
    run_fusion           = false // see note above
    run_splicing         = true
}

// Resource overrides scaled for the tiny chr21 test data -- conf/base.config's
// labels are sized for whole-genome production runs (e.g. 48GB for STAR
// indexing) and will not fit on most dev laptops. These values are generous
// for chr21-scale data on a typical modern laptop with Docker given a few
// GB of RAM. If your Docker runtime has less than this available (check
// `docker info`), pass an additional `-c` override config with smaller
// values -- don't lower these repo defaults for one machine's constraints.
// Docker Desktop on macOS enforces a low default nproc ulimit that causes
// the GATK JVM to fail with EPERM on pthread_create before it finishes
// initialising.  Raising these limits here is safe for local test runs.
docker.runOptions = '--ulimit nofile=65536:65536 --ulimit nproc=65536:65536'

process {
    withLabel: 'process_low'         { cpus = 1; memory = '1 GB';  time = '30m' }
    withLabel: 'process_medium'      { cpus = 2; memory = '2 GB';  time = '30m' }
    withLabel: 'process_high'        { cpus = 2; memory = '3 GB';  time = '1h'  }
    withLabel: 'process_high_memory' { cpus = 2; memory = '4 GB';  time = '1h'  }
}
