// Google Cloud Batch execution settings.
//
// TODO: fill in your GCP project, region, and a GCS bucket for the Nextflow
// work directory before running. Google Batch requires Docker (not
// Singularity) containers, which is why docker is force-enabled here.
//
// workDir cannot be a local path on Google Batch -- it must be a gs:// path.
// Setting it here works on modern Nextflow, but if your installed version
// does not pick up workDir from inside a profile block, pass it explicitly
// on the command line instead: `-w gs://YOUR_BUCKET/work`

google {
    project  = 'YOUR_GCP_PROJECT_ID' // TODO
    location = 'us-central1'         // TODO: pick a region close to your data/bucket
}

process {
    executor = 'google-batch'
}

workDir = 'gs://YOUR_BUCKET/work' // TODO

docker {
    enabled = true
}

singularity {
    enabled = false
}
