// KAIMRC HPC (Slurm) execution settings.
//
// TODO(KAIMRC): every value below is a placeholder. Fill in the real
// partition/queue name, account string, and a shared filesystem path before
// running on the cluster -- the pipeline will fail to submit jobs until you do.

process {
    executor       = 'slurm'
    queue          = 'normal'                    // TODO: real KAIMRC partition name (e.g. 'compute', 'bioinf')
    clusterOptions = '--account=YOUR_ACCOUNT_HERE' // TODO: KAIMRC project/account string
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/path/to/shared/singularity/cache' // TODO: shared filesystem path readable/writable by all compute nodes
}

docker {
    enabled = false
}
