// Global default parameters. All execution-environment specifics live in
// conf/*.config, included below via profiles -- this file should not need
// to change when moving between local/KAIMRC-Slurm/Google-Batch.

params {
    // Core inputs
    samplesheet  = null   // CSV: sample,fastq_1,fastq_2,condition,batch
    genome_fasta = null   // required if --star_index not given, AND required by run_variant_calling/run_fusion regardless
    gtf          = null
    star_index   = null   // pre-built STAR index dir; if null, built from genome_fasta + gtf
    outdir       = 'results'
    single_end   = false
    help         = false
    genome_build = 'GRCh38' // documentation/labeling only
    star_genome_sa_index_n_bases = 14 // STAR default for whole-genome references; reduce for small test genomes (e.g. test.config uses 11 for the chr21 subset)

    // Modality toggles
    run_dge             = true  // QC/align/count/DESeq2 -- on by default, same behavior as the original pipeline
    run_gsea             = true  // follows run_dge; independently toggleable
    run_variant_calling = false // opt-in: GATK chain is the most compute-expensive branch
    run_annotation       = true  // only relevant if run_variant_calling; independently toggleable
    run_fusion           = false // opt-in: needs Arriba blacklist/known-fusions reference files
    run_splicing         = false // opt-in: needs --read_length and --contrast

    // GATK RNA-seq variant calling
    known_sites = null // e.g. gs://genomics-public-data/resources/broad/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf.gz (+ .tbi alongside it)
    snpeff_db   = null // e.g. 'GRCh38.105'

    // Arriba fusion detection
    arriba_blacklist     = null // download from https://github.com/suhrig/arriba/releases for your genome build
    arriba_known_fusions = null

    // rMATS-turbo splicing
    read_length = null // required if run_splicing true; must match real FASTQ read length
    rmats_fdr   = 0.05

    // DESeq2 / GSEA
    contrast       = null            // e.g. "condition:treated_vs_control"
    design_formula = '~ condition'   // e.g. '~ batch + condition'
    msigdb_gmt     = null            // user-supplied .gmt, e.g. MSigDB Hallmark (registration required, not vendored)
}

// Resource labels (process_low/medium/high/high_memory) -- see conf/base.config
includeConfig 'conf/base.config'

profiles {

    docker {
        docker.enabled       = true
        singularity.enabled  = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled          = false
    }

    local {
        includeConfig 'conf/local.config'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    google_batch {
        includeConfig 'conf/google_batch.config'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

// Reporting
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

manifest {
    name            = 'kaimrc-rnaseq'
    author          = 'Dr. Mamoon Rashid'
    description     = 'Custom multi-modal RNA-seq pipeline: DGE, RNA-seq variant calling, fusion detection, alternative splicing, GSEA'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '2.0.0'
}
